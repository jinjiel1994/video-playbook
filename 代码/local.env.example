# 本机设置：复制成 local.env（同一个文件夹），按你的机器改。local.env 不进仓库。
# make.sh 和 跑一遍.sh 开头会读它。不设的项用默认值。

# 无头浏览器：指一个 chrome-headless-shell 可执行文件。不设就用 Playwright 自己下载的 chromium（npx playwright-core install chromium）。
# export CHROME=$HOME/somewhere/chrome-headless-shell-mac-arm64/chrome-headless-shell

# 带 numpy、scipy 的 Python：系统的 python3 缺包时，建一个 venv，把它的 bin 放到 PATH 最前面。
#   python3 -m venv $HOME/somewhere/py && $HOME/somewhere/py/bin/pip install numpy scipy
# export PATH=$HOME/somewhere/py/bin:$PATH

# 成片放哪（默认 ~/Documents/notes；示例片默认放自己的 build/out/）
# export OUT_DIR=$HOME/Movies

# 编码器：ffmpeg 没带 libx264 时自动用 videotoolbox；想强制用就设
# export VENC=videotoolbox
